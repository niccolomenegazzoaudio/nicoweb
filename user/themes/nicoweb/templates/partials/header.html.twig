<header class="site-header">
  <div class="container nav">
    <span class="brand" aria-label="Niccolò Menegazzo">
      Niccol<span class="brand__special-o" aria-hidden="true">O<span class="brand__o-accent">̀</span></span> Menegazzo
    </span>
    <button class="nav__toggle" aria-expanded="false" aria-controls="primary-nav">
      <span class="sr-only">Menu</span>
      <span class="bars"></span>
    </button>
    <nav id="primary-nav" class="nav__list" aria-label="Primario">
      <ul>
        {% for p in pages.children.visible if p.slug != 'home' %}
          <li>
            <a href="{{ p.url }}"{{ p.active ? ' aria-current="page"' : '' }}>{{ p.menu }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
