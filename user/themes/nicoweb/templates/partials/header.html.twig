<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/?skip=1" aria-label="Home">ò</a>
    <button class="nav__toggle" aria-expanded="false" aria-controls="primary-nav">
      <span class="sr-only">Menu</span>
      <span class="bars"></span>
    </button>
    <nav id="primary-nav" class="nav__list" aria-label="Primario">
      <ul>
        {% for p in pages.children.visible if p.slug != 'home' %}
          <li>
            <a href="{{ p.url }}"{{ p.active ? ' aria-current="page"' : '' }}>{{ p.menu }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
