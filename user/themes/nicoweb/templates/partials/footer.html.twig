{# Footer interno (non in home: il chrome è nascosto via base.html.twig).
   Tre colonne flex: copyright · social icons · link Home.
   Le icone si renderizzano solo se l'URL è settato in user/config/site.yaml
   (chiavi social.instagram / social.facebook / social.soundcloud) — vuote = nascoste. #}
{% set s = site.social|default({}) %}
<footer class="site-footer">
  <div class="container footer__bottom">
    <small class="muted">&copy; {{ "now"|date("Y") }} {{ site.title }}</small>

    {% if s.instagram or s.facebook or s.soundcloud %}
    <ul class="footer__social" aria-label="Profili social">
      {% if s.instagram %}
        <li><a href="{{ s.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r=".7" fill="currentColor" stroke="none"/>
          </svg>
        </a></li>
      {% endif %}
      {% if s.facebook %}
        <li><a href="{{ s.facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="3"/>
            <path d="M14.5 18V8.5a2 2 0 0 1 2-2h.5"/>
            <path d="M11.5 12h5"/>
          </svg>
        </a></li>
      {% endif %}
      {% if s.soundcloud %}
        <li><a href="{{ s.soundcloud }}" target="_blank" rel="noopener noreferrer" aria-label="SoundCloud">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M3 13v3M5.5 11v5M8 9.5v6.5M10.5 11v5"/>
            <path d="M13 16V9.5a3.5 3.5 0 0 1 6.95-.5A2.5 2.5 0 0 1 21 13.5a2.5 2.5 0 0 1-2.5 2.5H13z"/>
          </svg>
        </a></li>
      {% endif %}
    </ul>
    {% endif %}

    <small><a href="/" class="muted">Home</a></small>
  </div>
</footer>
