{% extends 'partials/base.html.twig' %}

{% set intro = page.header.intro|default({}) %}
{% set home  = page.header.home|default({}) %}
{% set drone = intro.drone|default({}) %}

{% set duration = intro.duration|default(5) %}
{% set fade     = intro.fade|default(1) %}
{% set freqA    = drone.freq_a|default(220) %}
{% set freqB    = drone.freq_b|default(220.4) %}
{% set fStart   = drone.filter_start|default(200) %}
{% set fEnd     = drone.filter_end|default(2000) %}

{% block content %}
{# Intro overlay sopra la home. Click → drone quasi-controfase + shimmer
   ({{ freqA }} / {{ freqB }} Hz fondamento 180° invertito · ottava + dodicesima
   modulate da LFO 0.3 Hz · pan -1→0/+1→0 · lowpass {{ fStart }}→{{ fEnd }} Hz · {{ duration }}s)
   Dopo {{ duration }}s fade out di {{ fade }}s; sotto c'è già la home normale. #}
<div id="intro" class="intro" role="button" tabindex="0" aria-label="Avvia presentazione">
  <span class="symbol" id="symbol">
    <span class="o-glyph">o</span>
    <span class="slash" aria-hidden="true"></span>
    <span class="accent" aria-hidden="true">ò</span>
  </span>
  <p class="intro__hint">tap to get in phase</p>
  <button type="button" class="intro__skip" id="intro-skip" aria-label="Salta intro">skip</button>
</div>

{# Home "vera" che vive sotto l'intro. Quando l'intro sparisce è già qui.
   La bio è hidden dal menu (visible:false in 02.bio/default.md) ma resta
   la single source of truth dei contenuti biografici — Nicco la edita da
   /admin → Pages → Bio e qui la pull-iamo via pages.find. #}
{% set bio = pages.find('/bio') %}

<section class="home-hero">
  <div class="container">
    {# Avvolge ogni "ò" del nome in uno span così la CSS può colorarne
       solo l'accento (stessa tecnica del brand nell'header). #}
    <h1 class="home-hero__name">{{ (home.name|default(site.title))|replace({'ò': '<span class="grave-o">ò</span>'})|raw }}</h1>
    <p class="home-hero__role">{{ home.role|default('Sound Designer · Sound Engineer') }}</p>
  </div>
</section>

{% if bio %}
<section class="home-bio">
  <div class="container">
    {# Stessa ricolorazione del grave applicata a tutte le "ò" della bio. #}
    <div class="home-bio__body">{{ bio.content|replace({'ò': '<span class="grave-o">ò</span>'})|raw }}</div>
  </div>
</section>
{% endif %}
{% endblock %}

{% block bottom %}
<script>
(() => {
  const intro = document.getElementById('intro');
  const symbol = document.getElementById('symbol');

  const DURATION = {{ duration }};
  const FADE     = {{ fade }};
  const FREQ_A   = {{ freqA }};
  const FREQ_B   = {{ freqB }};
  const F_START  = {{ fStart }};
  const F_END    = {{ fEnd }};

  let started = false;

  // Skip esplicito via query param: il link "Home" nel footer punta a /?skip=1
  // → arrivando da lì saltiamo l'intro e ripuliamo l'URL così un refresh
  // successivo torna a suonare l'intro normalmente.
  // (Niente più euristica referrer+navType: era fragile con Referrer-Policy,
  // nuove tab, ecc. — un flag esplicito è più affidabile.)
  const skipFromUrl = new URLSearchParams(location.search).has('skip');
  if (skipFromUrl) {
    history.replaceState(null, '', location.pathname);
    intro.style.display = 'none';
    document.body.classList.add('intro-done');
    return;
  }

  document.body.classList.add('intro-active');

  const reveal = () => {
    if (started) return;
    started = true;
    symbol.classList.add('active');
    intro.classList.add('revealed');

    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      const t = ctx.currentTime;

      // Fondamento — quasi-controfase.
      // Due sine vicine (FREQ_A / FREQ_B con detune ~0.4 Hz), il secondo
      // canale invertito (gain negativo = 180°). In stereo cancella il
      // phantom-center quando i panner convergono al centro; in mono il
      // detune evita la cancellazione totale, lascia un battimento lentissimo.
      const o1 = ctx.createOscillator();
      const o2 = ctx.createOscillator();
      const g1 = ctx.createGain();
      const g2 = ctx.createGain();
      const p1 = ctx.createStereoPanner ? ctx.createStereoPanner() : null;
      const p2 = ctx.createStereoPanner ? ctx.createStereoPanner() : null;
      const filter = ctx.createBiquadFilter();

      o1.type = 'sine'; o2.type = 'sine';
      o1.frequency.value = FREQ_A;
      o2.frequency.value = FREQ_B;
      filter.type = 'lowpass';
      filter.frequency.value = F_START;

      o1.connect(g1); o2.connect(g2);
      if (p1 && p2) { g1.connect(p1); g2.connect(p2); p1.connect(filter); p2.connect(filter); }
      else          { g1.connect(filter); g2.connect(filter); }

      // Reverb tail — ConvolverNode con IR sintetico (rumore bianco
      // stereo · decay esponenziale ~3.5s). Il filtro va sia direttamente
      // in destination (dry) sia nel convolver (wet) → quando le sorgenti
      // si fermano, la coda continua a suonare per qualche secondo.
      const conv = ctx.createConvolver();
      const irLen = Math.floor(ctx.sampleRate * 3.5);
      const ir = ctx.createBuffer(2, irLen, ctx.sampleRate);
      for (let ch = 0; ch < 2; ch++) {
        const data = ir.getChannelData(ch);
        for (let i = 0; i < irLen; i++) {
          data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / irLen, 2.2);
        }
      }
      conv.buffer = ir;
      const wetGain = ctx.createGain();
      wetGain.gain.value = 0.55;

      filter.connect(ctx.destination);   // dry
      filter.connect(conv);              // → wet
      conv.connect(wetGain);
      wetGain.connect(ctx.destination);

      if (p1 && p2) {
        p1.pan.setValueAtTime(-1, t); p2.pan.setValueAtTime(1, t);
        p1.pan.linearRampToValueAtTime(0, t + DURATION);
        p2.pan.linearRampToValueAtTime(0, t + DURATION);
      }
      filter.frequency.setValueAtTime(F_START, t);
      filter.frequency.linearRampToValueAtTime(F_END, t + DURATION);

      const peak = 0.25;
      g1.gain.setValueAtTime(peak, t);
      g1.gain.linearRampToValueAtTime(0, t + DURATION);
      g2.gain.setValueAtTime(-peak, t);  // inversione 180°
      g2.gain.linearRampToValueAtTime(0, t + DURATION);

      // Shimmer — ottava (FREQ_A·2) + dodicesima (FREQ_A·3), envelope soft
      // (1.5s di fade-in, sustain, fade-out a DURATION) modulato da un LFO
      // a 0.3 Hz. Stesso lowpass del fondamento → sboccia con lo sweep.
      const sh1 = ctx.createOscillator();
      const sh2 = ctx.createOscillator();
      sh1.type = 'sine'; sh2.type = 'sine';
      sh1.frequency.value = FREQ_A * 2;
      sh2.frequency.value = FREQ_A * 3;

      const shGain = ctx.createGain();
      sh1.connect(shGain); sh2.connect(shGain);
      shGain.connect(filter);

      const shPeak = 0.05;
      shGain.gain.setValueAtTime(0, t);
      shGain.gain.linearRampToValueAtTime(shPeak, t + 1.5);
      shGain.gain.setValueAtTime(shPeak, t + 1.5);
      shGain.gain.linearRampToValueAtTime(0, t + DURATION);

      const lfo = ctx.createOscillator();
      lfo.type = 'sine';
      lfo.frequency.value = 0.3;
      const lfoGain = ctx.createGain();
      lfoGain.gain.setValueAtTime(0, t);
      lfoGain.gain.linearRampToValueAtTime(shPeak * 0.7, t + 1.5);
      lfoGain.gain.setValueAtTime(shPeak * 0.7, t + 1.5);
      lfoGain.gain.linearRampToValueAtTime(0, t + DURATION);
      lfo.connect(lfoGain);
      lfoGain.connect(shGain.gain);

      o1.start(t); o2.start(t);
      sh1.start(t); sh2.start(t); lfo.start(t);
      o1.stop(t + DURATION + 0.05);
      o2.stop(t + DURATION + 0.05);
      sh1.stop(t + DURATION + 0.05);
      sh2.stop(t + DURATION + 0.05);
      lfo.stop(t + DURATION + 0.05);

      // Chiudi il context dopo che la coda di riverbero si è esaurita
      // (DURATION + 4s ≈ poco oltre la fine della IR di ~3.5s).
      setTimeout(() => { try { ctx.close(); } catch (_) {} }, (DURATION + 4) * 1000);
    } catch (e) { /* audio non disponibile, prosegui silenzioso */ }

    setTimeout(() => intro.classList.add('out'), DURATION * 1000);
    setTimeout(() => {
      intro.style.display = 'none';
      document.body.classList.remove('intro-active');
      document.body.classList.add('intro-done');
    }, (DURATION + FADE) * 1000);
  };

  intro.addEventListener('click', reveal);
  intro.addEventListener('keydown', (ev) => {
    if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); reveal(); }
  });

  const skipBtn = document.getElementById('intro-skip');
  if (skipBtn) {
    const skip = (ev) => {
      ev.stopPropagation();
      ev.preventDefault();
      intro.style.display = 'none';
      document.body.classList.remove('intro-active');
      document.body.classList.add('intro-done');
    };
    skipBtn.addEventListener('click', skip);
    skipBtn.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter' || ev.key === ' ') skip(ev);
    });
  }
})();
</script>
{% endblock %}
