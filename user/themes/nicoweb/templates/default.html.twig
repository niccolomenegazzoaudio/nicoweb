{% extends 'partials/base.html.twig' %}

{% block content %}
<section class="page">
  <div class="container">
    <header class="page__head">
      {% if page.header.eyebrow %}<p class="eyebrow mono muted">{{ page.header.eyebrow }}</p>{% endif %}
      <h1 class="page__title">{{ page.title }}</h1>
      {% if page.header.subtitle %}<p class="page__sub muted">{{ page.header.subtitle }}</p>{% endif %}
    </header>

    <div class="page__body">
      {{ page.content|raw }}
    </div>

    {% if page.header.clients %}
      <ul class="clients">
        {% for c in page.header.clients %}<li>{{ c }}</li>{% endfor %}
      </ul>
    {% endif %}
  </div>
</section>
{% endblock %}
