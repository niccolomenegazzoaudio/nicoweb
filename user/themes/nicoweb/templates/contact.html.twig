{% extends 'partials/base.html.twig' %}

{% block content %}
<section class="page page--contact">
  <div class="container">
    <header class="page__head">
      {% if page.header.eyebrow %}<p class="eyebrow mono muted">{{ page.header.eyebrow }}</p>{% endif %}
      <h1 class="page__title">{{ page.title }}</h1>
      {% if page.header.subtitle %}<p class="page__sub muted">{{ page.header.subtitle }}</p>{% endif %}
    </header>

    <div class="grid--contact">
      <div class="contact-form">
        {% include 'forms/form.html.twig' %}
      </div>

      <aside class="contact-info">
        {% if page.header.facts %}
          <dl class="kv">
            {% for f in page.header.facts %}
              <div class="kv__row"><dt>{{ f.label }}</dt><dd>{{ f.value|raw }}</dd></div>
            {% endfor %}
          </dl>
        {% endif %}
        {% if page.content %}<div class="contact-info__note muted">{{ page.content|raw }}</div>{% endif %}
      </aside>
    </div>
  </div>
</section>
{% endblock %}
