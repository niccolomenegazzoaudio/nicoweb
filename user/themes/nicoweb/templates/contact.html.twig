{% extends 'partials/base.html.twig' %}

{% block content %}
<section class="page">
  <div class="container">
    <header class="page__head">
      <h1 class="page__title">{{ page.title }}</h1>
      {% if page.header.subtitle %}<p class="page__sub muted">{{ page.header.subtitle }}</p>{% endif %}
    </header>

    <div class="page__body grid--contact">
      <div>
        {% include 'forms/form.html.twig' %}
      </div>
      <aside>
        {% if page.header.facts %}
          <dl class="kv">
            {% for f in page.header.facts %}
              <div class="kv__row"><dt>{{ f.label }}</dt><dd>{{ f.value|raw }}</dd></div>
            {% endfor %}
          </dl>
        {% endif %}
        {% if page.content %}<div class="muted" style="margin-top:18px">{{ page.content|raw }}</div>{% endif %}
      </aside>
    </div>
  </div>
</section>
{% endblock %}
