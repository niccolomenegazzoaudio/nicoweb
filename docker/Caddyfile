# Caddy per Grav (FrankenPHP).
# Il SERVER_NAME è configurato dal compose:
#   - dev:  ":80"  (HTTP only su localhost)
#   - prod: "niccolomenegazzo.com www.niccolomenegazzo.com"
#           (HTTPS automatico via Let's Encrypt)

{
    admin off
    {$CADDY_GLOBAL_OPTIONS}
    email {$ACME_EMAIL:niccolomenegazzoaudio@gmail.com}
    servers {
        trusted_proxies static private_ranges
    }
    # auto_https è ON di default; in dev viene disattivato dal compose
    # tramite SERVER_NAME=":80"
}

# `{$SERVER_NAME}` è espanso a runtime dal valore in compose.
{$SERVER_NAME} {
    root * /app
    encode zstd br gzip

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Nega l'accesso ai file e alle cartelle interne di Grav.
    # `route` forza l'ordine sorgente delle direttive.
    route {
        # 1) Dotfiles (.git, .env, .htaccess, …)
        @dotfiles path_regexp \/\.
        respond @dotfiles 404

        # 2) Cartelle di Grav che non devono mai essere servite via HTTP
        @forbidden path \
            /vendor/* /backup/* /logs/* /tmp/* /cache/* \
            /system/* /bin/* /tests/* \
            /user/accounts/* /user/config/* /user/data/* /user/env/* \
            /CHANGELOG.md /CONTRIBUTING.md /LICENSE.txt /README.md /SECURITY.md \
            /CODE_OF_CONDUCT.md /composer.json /composer.lock /now.json
        respond @forbidden 404

        # 3) Asset statici cacheabili dentro temi/plugin/user
        @assets {
            path_regexp \.(css|js|svg|png|jpe?g|webp|gif|ico|woff2?|ttf|otf|eot|mp3|wav|ogg|m4a)$
            file
        }
        handle @assets {
            header Cache-Control "public, max-age=2592000, immutable"
            file_server
        }

        # 4) Tutto il resto → Grav (PHP)
        # `try_files` instrada le route lette da Grav verso /index.php.
        try_files {path} /index.php?{query}

        @php path *.php
        handle @php {
            php
        }

        # 5) Qualunque file ancora servibile (favicon root, robots.txt, ecc.)
        @stillFile file
        handle @stillFile {
            file_server
        }

        # 6) Fallback: niente di sopra ha matchato → 404 di Grav
        rewrite * /index.php
        php
    }
}
